# ---------------------------------------------------------------------------
# Sistema de Solicitações e Compras — variáveis de ambiente
#
# Este arquivo contém APENAS placeholders/valores locais de exemplo e é o único
# arquivo de ambiente versionado. Copie-o para `.env` (ignorado pelo Git) e
# preencha os valores reais localmente. Nunca commite `.env`.
#
# Produção (Railway — Laravel App + PostgreSQL): não use `.env`; defina as
# variáveis em Railway → Variables (ver README, seção "Produção (Railway)"):
#   APP_ENV=production
#   APP_DEBUG=false                         (obrigatório)
#   APP_KEY=<gerada com `php artisan key:generate --show`, nunca versionada>
#   APP_URL=https://<dominio-publico>
#   DB_CONNECTION=pgsql
#   DB_HOST=${{Postgres.PGHOST}}            DB_PORT=${{Postgres.PGPORT}}
#   DB_DATABASE=${{Postgres.PGDATABASE}}    DB_USERNAME=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}    (ou DB_URL=${{Postgres.DATABASE_URL}})
#   LOG_CHANNEL=stderr  LOG_LEVEL=info  SESSION_SECURE_COOKIE=true
#   APP_NAME="Albuquerque Engenharia"    (nome visível; não é segredo)
#   MAIL_MAILER=resend  RESEND_API_KEY=    (chave gerada no painel do Resend; só no Railway)
#   MAIL_FROM_ADDRESS=  MAIL_FROM_NAME="${APP_NAME}"   (remetente no domínio verificado no Resend)
# Deploy: composer install --no-dev --optimize-autoloader → npm ci && npm run build
#   → php artisan migrate --force → config:cache/route:cache/view:cache → start.
# ---------------------------------------------------------------------------

APP_NAME="Albuquerque Engenharia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Em produção use LOG_CHANNEL=stderr (logs capturados pelo Railway) e LOG_LEVEL=info.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (único driver suportado). Em produção aponte para o serviço Railway.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

SESSION_DRIVER=database
# Em produção (HTTPS via proxy do Railway) defina SESSION_SECURE_COOKIE=true.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail transacional (convite de primeiro acesso, 72 h; redefinição de senha, 60 min).
# Local: `log` grava a mensagem completa, com o link, em storage/logs/laravel.log.
# Testes: `array` (phpunit.xml). Produção: transporte `resend` — defina as chaves abaixo
# APENAS em Railway → serviço Laravel → Variables (ver README, "E-mail transacional"):
# MAIL_MAILER=resend
# RESEND_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bootstrap do primeiro usuário Gestão (`php artisan users:create-gestao`): a senha inicial é
# informada só em tempo de execução (--password= ou esta variável exportada no shell).
# Nunca preencha aqui, no `.env` nem nas Variables do Railway.
# GESTAO_BOOTSTRAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
